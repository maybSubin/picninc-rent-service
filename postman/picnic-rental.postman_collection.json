              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"김피크\",\n  \"phone\": \"010-1234-5678\",\n  \"useDate\": \"{{today}}\",\n  \"items\": [\n    {\n      \"itemId\": 1,\n      \"quantity\": 1\n    },\n    {\n      \"itemId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "기본 용품 2개 → 400",
          "request": {
            "method": "POST",

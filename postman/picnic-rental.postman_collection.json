            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"김피크\",\n  \"phone\": \"010-1234-5678\",\n  \"useDate\": \"{{today}}\",\n  \"items\": [\n    {\n      \"itemId\": 2,\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "재고 초과(웨건 5개, 보유 4개) → 409",
          "request": {
            "method": "POST",
            "header": [
              {

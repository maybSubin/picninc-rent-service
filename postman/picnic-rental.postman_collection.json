{
  "info": {
    "name": "Picnic Rental API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "피크닉 용품 예약·대여 API. 샘플 용품(id 1~13)이 자동 등록된 상태에서 위에서부터 순서대로 실행하세요."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const kst = new Date(Date.now() + 9 * 60 * 60 * 1000);",
          "pm.collectionVariables.set('today', kst.toISOString().slice(0, 10));",
          "const next = new Date(kst.getTime() + 24 * 60 * 60 * 1000);",
          "pm.collectionVariables.set('tomorrow', next.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://picninc-rent-service-production.up.railway.app"
    },
    {
      "key": "reservationId",
      "value": "1"
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "tomorrow",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "용품",
      "item": [
        {
          "name": "1. 용품 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"아이스박스\",\n  \"type\": \"OPTION\",\n  \"price\": 5000,\n  \"stock\": 5,\n  \"description\": \"25L 하드 아이스박스\"\n}"
            }
          }
        },
        {
          "name": "2. 용품 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2-1. 기본 용품만 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items?type=BASIC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "BASIC"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "3. 용품 상세",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "1"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "4. 날짜별 예약 가능 수량",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/availability?date={{today}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "availability"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{today}}"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "예약 · 대여",
      "item": [
        {
          "name": "5. 예약 생성 (텐트 + 테이블 + 체어 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations"
              ]
            },
            "description": "이용 날짜는 오늘(KST). 생성된 id를 reservationId 변수에 저장합니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"김피크\",\n  \"phone\": \"010-1234-5678\",\n  \"useDate\": \"{{today}}\",\n  \"items\": [\n    {\n      \"itemId\": 1,\n      \"quantity\": 1\n    },\n    {\n      \"itemId\": 3,\n      \"quantity\": 1\n    },\n    {\n      \"itemId\": 6,\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('reservationId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "6. 예약 상세",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{reservationId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "7. 대여 (이용 당일 수령)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/rent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{reservationId}}",
                "rent"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "8. 반납",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{reservationId}}",
                "return"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "9. 예약 취소 (RESERVED 상태에서만)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{reservationId}}",
                "cancel"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "\"반납까지 마친 예약에 호출하면 409 INVALID_STATUS. 새 예약을 만든 뒤 호출해 보세요.\""
            }
          }
        },
        {
          "name": "10. 예약별 활동 로그 (MongoDB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{reservationId}}",
                "logs"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "예외 케이스",
      "item": [
        {
          "name": "기본 용품 미선택 → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",

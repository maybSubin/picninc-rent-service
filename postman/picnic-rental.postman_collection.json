              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"김피크\",\n  \"phone\": \"010-1234-5678\",\n  \"useDate\": \"{{today}}\",\n  \"items\": [\n    {\n      \"itemId\": 3,\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "텐트+돗자리 동시 선택 → 400",

            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"김피크\",\n  \"phone\": \"010-1234-5678\",\n  \"useDate\": \"2020-01-01\",\n  \"items\": [\n    {\n      \"itemId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "내일 예약 후 오늘 대여 시도용 예약",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations"
              ]
            },
            "description": "생성 후 7. 대여를 호출하면 409 NOT_USE_DATE",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"김피크\",\n  \"phone\": \"010-1234-5678\",\n  \"useDate\": \"{{tomorrow}}\",\n  \"items\": [\n    {\n      \"itemId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('reservationId', pm.response.json().id); }"
                ]
